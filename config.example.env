# Application environment and local listener.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8088
PUBLIC_BASE_URL=http://127.0.0.1:8088

# Storage paths relative to the project root.
DATABASE_PATH=data/approval_gateway.sqlite3
LOG_PATH=logs/approval_gateway.log

# Approval expiry and callback connection timeout.
DEFAULT_EXPIRY_HOURS=24
CALLBACK_TIMEOUT_SECONDS=10

# Meta credentials required for live WhatsApp mode.
META_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Template identifiers must match the registered Meta template.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=workflow_approval_document
WHATSAPP_TEMPLATE_LANGUAGE=en

# Simulate delivery during local development.
DRY_RUN_WHATSAPP=true