{
  "systems": {
    "peta": {
      "enabled": false,
      "factory": "peta:build_adapter",
      "options": {
        "api_base_url_env": "PETA_API_BASE_URL",
        "access_token_env": "PETA_ACCESS_TOKEN",
        "directory_base_url": "https://user-directory.abooderp.com/api/v1/client",
        "directory_access_token_env": "USER_DIRECTORY_ACCESS_TOKEN",
        "local_calling_code": "255",
        "directory_service_id_env": "PETA_DIRECTORY_SERVICE_ID",
        "directory_shared_user_ids": true
      }
    },
    "generic_example": {
      "enabled": false,
      "factory": "generic:build_adapter",
      "options": {
        "verify_url": "https://erp.example.com/api/whatsapp-approvals/verify",
        "verify_token_env": "GENERIC_ERP_VERIFY_TOKEN"
      }
    }
  }
}
